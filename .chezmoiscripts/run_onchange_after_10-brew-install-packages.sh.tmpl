{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install Homebrew packages listed in .chezmoidata/packages.yaml (macOS only).
# chezmoi re-runs this script whenever the rendered package list changes.
set -Eeuo pipefail
trap 'echo >&2 "brew package install failed (line ${LINENO})"' ERR

if [[ ! -x /opt/homebrew/bin/brew ]]; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# A fresh install is not on PATH yet, so load it into this process
eval "$(/opt/homebrew/bin/brew shellenv)"

# --no-upgrade: only install missing packages; upgrade manually with "brew upgrade"
brew bundle --no-upgrade --file=/dev/stdin <<'EOF'
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

{{ if has "docker" .packages.darwin.brews -}}
# Add the Homebrew CLI plugin directory to ~/.docker/config.json.
# Merge with jq so existing keys (auths, credsStore, ...) stay untouched.
docker_config="$HOME/.docker/config.json"
mkdir -p "$HOME/.docker"
[[ -f "$docker_config" ]] || echo '{}' > "$docker_config"

tmp_file="$(mktemp "$docker_config.XXXXXX")"
/usr/bin/jq --arg dir "$(brew --prefix)/lib/docker/cli-plugins" \
  '.cliPluginsExtraDirs = (((.cliPluginsExtraDirs // []) + [$dir]) | unique)' \
  "$docker_config" > "$tmp_file"
mv "$tmp_file" "$docker_config"
{{ end -}}
{{ end -}}
