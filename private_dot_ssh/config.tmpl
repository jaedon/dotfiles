{{ if eq .chezmoi.os "darwin" -}}
Include {{ .chezmoi.homeDir }}/.colima/ssh_config

{{ end -}}
Include {{ .chezmoi.homeDir }}/.ssh/config.d/*.conf

Host *
    User ubuntu
    ServerAliveInterval 60
    ServerAliveCountMax 10
    TCPKeepAlive yes
    IPQoS=throughput
{{- if eq .chezmoi.os "darwin" }}
    SecurityKeyProvider /usr/lib/ssh-keychain.dylib
{{ end -}}
