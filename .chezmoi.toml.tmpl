{{- /* Precedence: env DOTFILES_<KEY> > stored value > prompt (TTY) > default (no TTY) */ -}}
{{- $interactive := stdinIsATTY -}}
{{- $defaults := dict "name" "Jaedon Shin" "email" "jaedon.shin@gmail.com" -}}
{{- $values := dict -}}
{{- range $key, $default := $defaults -}}
{{-   $value := env (printf "DOTFILES_%s" (upper $key)) -}}
{{-   if not $value -}}
{{-     if $interactive -}}
{{-       $value = promptStringOnce $ $key (title $key) $default -}}
{{-     else -}}
{{-       $value = get $ $key | default $default -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $values $key $value -}}
{{- end -}}

{{- /* LM Studio runs on the Mac: local on macOS, remote elsewhere. No prompt. */ -}}
{{- $lmstudio := ternary "http://127.0.0.1:1234/v1" "http://mac.lan:1234/v1" (eq .chezmoi.os "darwin") -}}
{{- $lmstudio = env "DOTFILES_LMSTUDIO_URL" | default $lmstudio -}}

[data]
    name = {{ $values.name | quote }}
    email = {{ $values.email | quote }}
    lmstudioBaseURL = {{ $lmstudio | quote }}

[diff]
    exclude = ["scripts"]
